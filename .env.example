# Copy to .env and fill in. Read by app/config/settings.py; a real
# shell-exported variable always wins over this file.

# Required - the app refuses to start if either is unset.
PRAISE_API_KEY=
PRAISE_MYID=

# Optional - defaults shown.
# PRAISE_IR_CAL_BASE_URL=https://praise-web.ust.hk/uwsgi/praise-ir-cal
# PRAISE_MAX_ROWS_PER_CALL=40
# PRAISE_REQUEST_TIMEOUT_SECONDS=60
# expo_calx calls running at once, shared by all batches in one process.
# PRAISE_MAX_CONCURRENT_CALLS=10
# Largest accepted POST /ingest body (5 MB); larger uploads get 413.
# MAX_INGEST_BODY_BYTES=5242880
# LOG_LEVEL=INFO

# Where the SQLite file lives. Point this at a mounted persistent volume in
# production, or data is lost on every restart.
# EXPOSURE_DB_PATH=exposure.db

# Road centrelines (GeoJSON), loaded at startup; the app refuses to start
# without them. Download with: python -m app.services.road_service
# ROAD_CENTRELINES_PATH=data/road_centrelines/RoadCentreLine.geojson
