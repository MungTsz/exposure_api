# Required — praise_client.py reads these with os.environ[...] (no default),
# so the process fails to start if either is unset.
PRAISE_API_KEY=
PRAISE_MYID=

# Optional — overrides the expo_calx base URL (see praise_client.py).
# PRAISE_IR_CAL_BASE_URL=https://praise-web.ust.hk/uwsgi/praise-ir-cal

# Optional — where the SQLite file lives (see db.py). Point this at a
# mounted persistent volume in production, or data is lost on every restart.
# EXPOSURE_DB_PATH=exposure.db
